---
import { site } from '../data/site';
import type { Lang } from '../data/site';
import { useTranslations, localizePath } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);

const items = [
  { key: 'nav.works', href: '/works' },
  { key: 'nav.statement', href: '/statement' },
  { key: 'nav.exhibitions', href: '/exhibitions' },
  { key: 'nav.profile', href: '/profile' },
  { key: 'nav.contact', href: '/contact' },
] as const;

const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={localizePath(lang, '/')}>
      {site.name[lang]}
      <span class="brand__role">{site.role[lang]}</span>
    </a>

    <nav class="nav" aria-label={lang === 'zh' ? '主要導覽' : 'Main navigation'}>
      {
        items.map((item) => (
          <a
            class="nav__link"
            href={localizePath(lang, item.href)}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {t(item.key)}
          </a>
        ))
      }
      <span class="lang">
        <a class="lang__link" href={localizePath('zh', path)} aria-current={lang === 'zh' ? 'true' : undefined}>中文</a>
        <span class="lang__sep">/</span>
        <a class="lang__link" href={localizePath('en', path)} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </span>
    </nav>
  </div>
</header>
