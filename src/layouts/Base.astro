---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import type { Lang } from '../data/site';
import { useTranslations, localizePath } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 分頁標題(不含站名) */
  title?: string;
  description?: string;
  /** 不含語言前綴的路徑,例如 /works */
  path?: string;
  /** 分享預覽圖。不給的話用精選作品的封面 */
  ogImage?: ImageMetadata;
  /** 不該被索引的頁(例如 404),略過 canonical 與 hreflang */
  noindex?: boolean;
}

const { lang, title, description, path = '/', ogImage, noindex = false } = Astro.props;
const t = useTranslations(lang);

const siteName = site.name[lang];
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} — ${site.role[lang]}`;
const desc = description ?? site.description[lang];
const canonical = new URL(localizePath(lang, path), Astro.site);
const zhHref = new URL(localizePath('zh', path), Astro.site);
const enHref = new URL(localizePath('en', path), Astro.site);

/* 分享預覽圖。沒有 og:image 的話,連結貼到 LINE / Facebook / Threads 不會有預覽 —
   對作品集網站等於少掉最重要的一眼。用 jpeg 而非 webp,舊的爬蟲相容性較好。 */
let ogSource: ImageMetadata | undefined = ogImage;
if (!ogSource) {
  const works = await getCollection('works');
  ogSource = (works.find((w) => w.data.featured) ?? works[0])?.data.cover;
}
/* 維持原始比例輸出,寬高照實宣告。
   注意:Astro 內建的 sharp 服務不支援 contain + background 留白
   (給了 fit/background 也只會縮到框內,產出尺寸和宣告的 1200×630 對不上),
   所以直式作品在 1.91:1 的社群卡片上仍會被平台自己裁切。 */
const OG_MAX_WIDTH = 1200;
const og = ogSource
  ? await getImage({ src: ogSource, width: OG_MAX_WIDTH, format: 'jpeg', quality: 82 })
  : null;
const ogUrl = og ? new URL(og.src, Astro.site).href : null;
/* 宣告尺寸必須等於實際輸出。Astro 不會把圖放大,所以來源比 1200 窄時
   輸出就是來源原寬(例如 tung-cat 只有 1108px)。 */
const ogWidth = ogSource ? Math.min(OG_MAX_WIDTH, ogSource.width) : null;
const ogHeight = ogSource && ogWidth ? Math.round((ogSource.height / ogSource.width) * ogWidth) : null;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="zh-Hant" href={zhHref} />
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={zhHref} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#14100d" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />
    {
      ogUrl && ogWidth && ogHeight && (
        <>
          <meta property="og:image" content={ogUrl} />
          <meta property="og:image:width" content={String(ogWidth)} />
          <meta property="og:image:height" content={String(ogHeight)} />
          <meta property="og:image:alt" content={pageTitle} />
          <meta name="twitter:image" content={ogUrl} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Noto+Sans+TC:wght@300;400&family=Noto+Serif+TC:wght@300;400&display=swap"
    />

    {/* 研出效果的初始隱藏狀態限定在 .js 之下,沒有 JS 時內容要直接可見。
        這段必須內嵌且盡早執行,否則會先閃一下未套用的畫面。 */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <dialog class="lightbox" id="lightbox">
      <button class="lightbox__close" type="button" data-lightbox-close>{t('lightbox.close')}</button>
      <img class="lightbox__img" alt="" />
    </dialog>

    <script>
      // 研出:滾到視窗內才把黑磨開
      function initTogidashi() {
        document.documentElement.classList.add('js');

        const targets = document.querySelectorAll('.togidashi');
        if (!targets.length) return;

        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-shown'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target;
              io.unobserve(el);
              // 磨完就把遮罩拿掉,只留下完成狀態。
              // animationend 會冒泡,要確認是這個元素自己的動畫才收尾。
              const finish = (e) => {
                if (e.target !== el) return;
                el.removeEventListener('animationend', finish);
                el.classList.remove('is-revealed');
                el.classList.add('is-shown');
              };
              el.addEventListener('animationend', finish);
              el.classList.add('is-revealed');
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
        );

        targets.forEach((el) => io.observe(el));
      }

      // 放大檢視。document 不會被 View Transitions 換掉,所以只掛一次委派。
      function wireLightbox() {
        document.addEventListener('click', (event) => {
          const dialog = document.getElementById('lightbox');
          if (!dialog) return;

          if (event.target.closest('[data-lightbox-close]')) {
            dialog.close();
            return;
          }

          // 點圖片以外的區域(dialog 本身)就關閉
          if (dialog.open && event.target === dialog) {
            dialog.close();
            return;
          }

          const trigger = event.target.closest('[data-zoom]');
          if (!trigger) return;

          const source = trigger.querySelector('img');
          const target = dialog.querySelector('.lightbox__img');
          if (!source || !target) return;

          // currentSrc 是瀏覽器依 srcset 實際選用的那張
          target.src = source.currentSrc || source.src;
          target.alt = source.alt || '';
          dialog.showModal();
        });
      }

      wireLightbox();
      // astro:page-load 首次載入與每次換頁都會觸發
      document.addEventListener('astro:page-load', initTogidashi);
    </script>
  </body>
</html>
