---
import Base from '../layouts/Base.astro';
import ExhibitionsView from '../views/ExhibitionsView.astro';
import { useTranslations } from '../i18n/ui';

const lang = 'zh' as const;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('exhibitions.title')} path="/exhibitions">
  <ExhibitionsView lang={lang} />
</Base>
